# Backend: set Gemini or OpenAI credentials in your hosting provider's encrypted environment settings.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=auto
EMBEDDING_MODEL=auto

# Set this to your managed PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://postgres:your_password@your-postgres-host:5432/srm?sslmode=require

# Comma-separated public frontend URLs, for example https://your-app.onrender.com
CORS_ALLOW_ORIGINS=https://your-frontend-host.example.com

# Used only for local Docker Compose development.
POSTGRES_PASSWORD=change_me
